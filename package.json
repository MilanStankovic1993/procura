{
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=26.0.0"
    },
    "scripts": {
        "build": "npm run build:frontend",
        "build:frontend": "npm --prefix frontend run build && npm run verify:production-serving",
        "dev": "npm --prefix frontend start",
        "lint:frontend": "npm --prefix frontend run check:i18n && npm --prefix frontend run lint",
        "check:i18n": "npm --prefix frontend run check:i18n",
        "test:frontend": "npm --prefix frontend run test -- --watch=false",
        "verify:production-serving": "node tools/verify-production-serving.mjs"
    }
}
