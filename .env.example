APP_NAME=Procura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://procura.test
FRONTEND_URL=http://localhost:4200
FRONTEND_URLS=http://localhost:4200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200,procura.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LISTING_UPLOAD_DISK=local
MARKETPLACE_IMPORT_DISK=local
MARKETPLACE_CSV_IMPORT_ENABLED=false
MARKETPLACE_CONNECTOR_QUEUE=connectors
MARKETPLACE_IMPORT_MAX_FILE_KB=5120
MARKETPLACE_IMPORT_MAX_ROWS=10000
MARKETPLACE_IMPORT_PROCESSING_TIMEOUT_SECONDS=900
QUEUE_CONNECTION=database
OPERATIONS_READINESS_DATABASE_CONNECTION=
OPERATIONS_READINESS_CACHE_STORE=
OPERATIONS_DASHBOARD_CACHE_STORE=
OPERATIONS_DASHBOARD_CACHE_TTL_SECONDS=30
OPERATIONS_QUEUE_HEARTBEATS_ENABLED=false
OPERATIONS_QUEUE_HEARTBEAT_QUEUES=analyses,connectors,notifications,default
OPERATIONS_QUEUE_HEARTBEAT_MAX_AGE_SECONDS=180
OPERATIONS_QUEUE_HEARTBEAT_MAX_LATENCY_SECONDS=120
OPERATIONS_QUEUE_HEARTBEAT_TTL_SECONDS=900
DB_QUEUE_RETRY_AFTER=960
ANALYSIS_PROVIDER=fake
ANALYSIS_QUEUE=analyses
ANALYSIS_MANUAL_RETRY_ENABLED=false
ANALYSIS_MANUAL_RETRY_ATTEMPTS=3
ANALYSIS_MANUAL_RETRY_MAX_RUNS=5
PRODUCT_MATCHING_PROVIDER=fake

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MONITORING_EMAIL_QUEUE=notifications
MONITORING_EMAIL_PROVIDER=laravel-mail
MONITORING_TELEGRAM_QUEUE=notifications
MONITORING_TELEGRAM_PROVIDER=telegram-bot-api
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_IDENTITY_HASH_KEY=
TELEGRAM_WEBHOOK_URL=

BILLING_PROVIDER=stripe
BILLING_CHECKOUT_ENABLED=false
BILLING_ALLOW_PROMOTION_CODES=false
BILLING_COLLECT_TAX_IDS=true
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=en_IE
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
BILLING_PRICE_STARTER_MONTHLY_MINOR=0
BILLING_PRICE_STARTER_YEARLY_MINOR=0
BILLING_PRICE_PRO_MONTHLY_MINOR=0
BILLING_PRICE_PRO_YEARLY_MINOR=0

PRIVACY_WORKFLOW_VERSION=privacy-request-workflow:v1
PRIVACY_NOTICE_VERSION=privacy-notice:v1
PRIVACY_RESPONSE_TARGET_DAYS=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
