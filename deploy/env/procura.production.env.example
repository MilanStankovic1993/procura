# Procura production environment template.
# Copy values into the target platform's encrypted secret manager. Never commit the completed file.
# Every example host, empty credential, proxy range, provider identifier, and policy value must be reviewed.

APP_NAME=Procura
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://procura.example.com
FRONTEND_URL=https://procura.example.com
FRONTEND_URLS=https://procura.example.com
TRUSTED_PROXIES=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=procura
DB_USERNAME=procura_app
DB_PASSWORD=
DB_TIMEZONE=+00:00
MYSQL_ATTR_SSL_CA=

CACHE_STORE=redis
CACHE_PREFIX=procura_production_cache
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_RETRY_AFTER=960

QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
ANALYSIS_QUEUE=analyses
MARKETPLACE_CONNECTOR_QUEUE=connectors
MONITORING_EMAIL_QUEUE=notifications
MONITORING_TELEGRAM_QUEUE=notifications

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=procura.example.com

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Procura

FILESYSTEM_DISK=s3
LISTING_UPLOAD_DISK=s3
OWNED_PRODUCT_UPLOAD_DISK=s3
MARKETPLACE_IMPORT_DISK=s3
BROKER_REPORT_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_THROW=true
AWS_REPORT=true

OPERATIONS_READINESS_DATABASE_CONNECTION=mysql
OPERATIONS_READINESS_CACHE_STORE=redis
OPERATIONS_DASHBOARD_CACHE_STORE=redis
OPERATIONS_DASHBOARD_CACHE_TTL_SECONDS=30
OPERATIONS_QUEUE_HEARTBEATS_ENABLED=false
OPERATIONS_QUEUE_HEARTBEAT_QUEUES=analyses,connectors,notifications,default
OPERATIONS_QUEUE_HEARTBEAT_MAX_AGE_SECONDS=180
OPERATIONS_QUEUE_HEARTBEAT_MAX_LATENCY_SECONDS=120
OPERATIONS_QUEUE_HEARTBEAT_TTL_SECONDS=900
PERFORMANCE_ANALYSIS_WORKLOAD_ENABLED=false
PERFORMANCE_ANALYSIS_WORKLOAD_CACHE_STORE=redis

# Keep core analysis disabled until a reviewed non-fake provider and product matcher are installed.
ANALYSIS_PROVIDER=fake
ANALYSIS_SUBMISSION_ENABLED=false
PRODUCT_MATCHING_PROVIDER=fake
ANALYSIS_MANUAL_RETRY_ENABLED=false
ANALYSIS_MANUAL_RETRY_ATTEMPTS=3
ANALYSIS_MANUAL_RETRY_MAX_RUNS=5

MARKETPLACE_CSV_IMPORT_ENABLED=false
MARKETPLACE_IMPORT_MAX_FILE_KB=5120
MARKETPLACE_IMPORT_MAX_ROWS=10000
MARKETPLACE_IMPORT_PROCESSING_TIMEOUT_SECONDS=900

MONITORING_EMAIL_PROVIDER=laravel-mail
MONITORING_TELEGRAM_PROVIDER=telegram-bot-api
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_IDENTITY_HASH_KEY=
TELEGRAM_WEBHOOK_URL=https://procura.example.com/api/v1/integrations/telegram/webhook

BILLING_PROVIDER=stripe
BILLING_CHECKOUT_ENABLED=false
BILLING_ALLOW_PROMOTION_CODES=false
BILLING_COLLECT_TAX_IDS=true
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=en_IE
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
BILLING_PRICE_STARTER_MONTHLY_MINOR=0
BILLING_PRICE_STARTER_YEARLY_MINOR=0
BILLING_PRICE_PRO_MONTHLY_MINOR=0
BILLING_PRICE_PRO_YEARLY_MINOR=0

BROKER_REQUESTS_ENABLED=false
BROKER_OFFERS_ENABLED=false
BROKER_TRANSACTIONS_ENABLED=false
BROKER_PAYMENT_CASES_ENABLED=false
BROKER_COMMISSION_RULE_VERSION=broker-commission:v1
BROKER_COMMISSION_RATE_BASIS_POINTS=0
BROKER_REPORTS_ENABLED=false
BROKER_REPORT_VERSION=broker-transaction-report:v1
BROKER_REPORT_RETENTION_DAYS=30
BROKER_REPORT_DOWNLOAD_TTL_MINUTES=10
BROKER_REPORT_MAX_BYTES=5242880
BROKER_REPORT_PURGE_BATCH=100
BROKER_MONITOR_REQUEST_AGE_HOURS=48
BROKER_MONITOR_OFFER_EXPIRY_GRACE_HOURS=1
BROKER_MONITOR_TRANSACTION_AGE_HOURS=24
BROKER_MONITOR_COMMISSION_AGE_HOURS=72
BROKER_MONITOR_REPORT_PURGE_GRACE_HOURS=26
BROKER_MONITOR_PAYMENT_CASE_AGE_HOURS=48

PRIVACY_WORKFLOW_VERSION=privacy-request-workflow:v1
PRIVACY_NOTICE_VERSION=privacy-notice:v1
PRIVACY_RESPONSE_TARGET_DAYS=30
PRIVACY_FULFILLMENT_ENABLED=false
PRIVACY_FULFILLMENT_VERSION=privacy-fulfillment:v1
PRIVACY_DATA_INVENTORY_VERSION=privacy-data-inventory:v4
PRIVACY_EXPORT_MAX_BYTES=104857600
PRIVACY_EXPORT_MAX_RETENTION_DAYS=30
PRIVACY_ERASURE_ENABLED=false
PRIVACY_ERASURE_VERSION=privacy-erasure:v1
PRIVACY_ERASURE_INVENTORY_VERSION=privacy-erasure-inventory:v4
PRIVACY_BACKUP_MAX_RETENTION_DAYS=90
